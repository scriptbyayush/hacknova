# MeetFlow AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── GitHub Integration ───────────────────────────────────────────────────────
# Personal Access Token with: repo (full) or issues (read/write) scope
# Fine-grained PAT: Repository > Issues > Read and Write
# Classic PAT: repo scope
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Default repository (owner/repo format)
GITHUB_DEFAULT_REPO=scriptbyayush/hacknova

# ─── AI Provider (optional) ──────────────────────────────────────────────────
# Gemini API key for live AI extraction
GEMINI_API_KEY=AIzaSy...

# OpenAI API key (alternative)
OPENAI_API_KEY=sk-...

# ─── Server Config ────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
